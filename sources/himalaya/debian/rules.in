#!/usr/bin/make -f

export PATH := @RUST_INSTALL_PREFIX@/bin:$(PATH)
export CARGO_HOME := $(CURDIR)/debian/.cargo-home
export CARGO_NET_OFFLINE := true
export CARGO_TARGET_DIR := $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --offline
	mkdir -p debian/generated/man
	./target/release/himalaya man debian/generated/man
	gzip -9n debian/generated/man/*.1
	./target/release/himalaya completion bash > debian/generated/himalaya.bash
	./target/release/himalaya completion fish > debian/generated/himalaya.fish
	./target/release/himalaya completion zsh > debian/generated/_himalaya

override_dh_auto_clean:
	rm -rf target debian/.cargo-home debian/generated

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_clean:
	dh_clean -Xvendor/
