#!/usr/bin/make -f

export PATH := {{RUST_INSTALL_PREFIX}}/bin:$(PATH)
export CARGO_HOME := $(CURDIR)/debian/.cargo-home
export CARGO_NET_OFFLINE := true
export CARGO_TARGET_DIR := $(CURDIR)/target

{{RUST_BUILD_TUNING}}

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --offline --bin just
	mkdir -p debian/generated/man
	./target/release/just --completions bash > debian/generated/just.bash
	./target/release/just --completions fish > debian/generated/just.fish
	./target/release/just --completions zsh > debian/generated/_just
	./target/release/just --man > debian/generated/man/just.1
	gzip -9n debian/generated/man/just.1

override_dh_auto_clean:
	rm -rf target debian/.cargo-home debian/generated

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_clean:
	dh_clean -Xvendor/
