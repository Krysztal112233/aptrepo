#!/usr/bin/env bash
# Vendor the out-of-tree DuckDB extensions that we statically link into the
# CLI (see debian/rules.in). Runs on the host during source preparation with
# the extracted duckdb source tree as cwd.
#
# duckdb v2's default build flow (DUCKDB_NEW_EXTENSION_BUILD=1) syncs
# out-of-tree extensions by cloning them into extension/external/<name>;
# here in the package build that step runs inside the offline sbuild chroot,
# so we pre-populate those clones (git metadata included: the sync script
# and cmake's version detection both want .git) and set
# DUCKDB_SKIP_APPLYING_PATCHES=1 in debian/rules so the in-chroot sync
# leaves the trees untouched. None of the four extensions carries official
# patches in this duckdb version's configs, so nothing is skipped that
# upstream would apply.
#
# The pins are the GIT_TAGs that this duckdb version's own release configs
# point at (.github/config/extensions/<name>.cmake in the source tree);
# re-read them when bumping the duckdb version. Keep the edits below in
# sync with the vendored sources; the build aborts loudly when an anchor
# no longer matches.
set -euo pipefail

out=extension/external
mkdir -p "$out"

clone() { # <name> <url> <commit> [submodule-path]
  local name=$1 url=$2 commit=$3 dest="$out/$1"
  rm -rf "$dest"
  git clone -q "$url" "$dest"
  git -C "$dest" checkout -q "$commit"
  # Only the submodule the duckdb release config names (database-connector);
  # the repos also carry duckdb/extension-ci-tools submodules that are for
  # standalone development (~300 MB of duckdb checkout) and unused here.
  if [ $# -ge 4 ]; then git -C "$dest" submodule update --init -q "$4"; fi
}

clone httpfs https://github.com/duckdb/duckdb-httpfs \
  77392a72077a85897db2519fae11e2c0da972b8a
clone postgres_scanner https://github.com/duckdb/duckdb-postgres \
  c0f5a3c0c4b68b02afbf669d36d7f0e503985c88 database-connector
clone mysql_scanner https://github.com/duckdb/duckdb-mysql \
  f7fc0d42716534aa5ad48626d21ced9807b33967 database-connector
clone sqlite_scanner https://github.com/duckdb/duckdb-sqlite \
  e223dc01493414cef6d5960744f1e048d59fc592 database-connector

python3 - "$out" <<'EOF'
import json, pathlib, sys

out = pathlib.Path(sys.argv[1])


def rewrite(path, old, new):
    text = path.read_text()
    assert text.count(old) == 1, f"{path}: patch anchor missing or ambiguous"
    path.write_text(text.replace(old, new))


# postgres: upstream links libpq/OpenSSL only into the loadable; the static
# archive must propagate them too, or the duckdb binary misses the symbols.
# Plain signature, to match build_static_extension's own plain call on the
# same target (cmake rejects mixing plain and keyword signatures).
rewrite(
    out / "postgres_scanner/CMakeLists.txt",
    """target_link_libraries(${LOADABLE_EXTENSION_NAME} OpenSSL::SSL OpenSSL::Crypto
                      PostgreSQL::PostgreSQL ${CURL_LIBRARIES})
""",
    """target_link_libraries(${LOADABLE_EXTENSION_NAME} OpenSSL::SSL OpenSSL::Crypto
                      PostgreSQL::PostgreSQL ${CURL_LIBRARIES})

# Static link propagation for the duckdb binary (see pre-vendor).
target_link_libraries(${EXTENSION_NAME} OpenSSL::SSL OpenSSL::Crypto
                      PostgreSQL::PostgreSQL)
""",
)

# postgres: postgres_oauth.cpp uses the OAuth bearer API that libpq only
# gained in PostgreSQL 18, while Debian trixie ships libpq 17. Compile the
# real implementation on libpq >= 18 and stub the hook out otherwise (the
# pg_oauth_token setting remains accepted but inert).
oauth = out / "postgres_scanner/src/postgres_oauth.cpp"
text = oauth.read_text()
marker = "namespace duckdb {"
assert text.count(marker) == 1, f"{oauth}: namespace marker changed"
prefix, body = text.split(marker, 1)
oauth.write_text(
    prefix
    + '#include "pg_config.h"\n'
    + "#if defined(PG_VERSION_NUM) && PG_VERSION_NUM >= 180000\n"
    + marker
    + body
    + """
#else
namespace duckdb {
OAuthTokenHolder::~OAuthTokenHolder() {
}
void PostgresInitOAuthHook() {
}
OAuthTokenHolder SetThreadLocalOAuthTokenFromSessionOption(ClientContext &) {
\treturn OAuthTokenHolder();
}
} // namespace duckdb
#endif
"""
)

# mysql: its catalog helpers GetSecret/CatalogTypeIsSupported have external
# linkage and collide with the postgres scanner's identically named ones
# when both are statically linked into one binary. They are used only within
# their own translation units, so give them internal linkage.
rewrite(
    out / "mysql_scanner/src/storage/mysql_catalog.cpp",
    "unique_ptr<SecretEntry> GetSecret(ClientContext &context, const string &secret_name) {",
    "static unique_ptr<SecretEntry> GetSecret(ClientContext &context, const string &secret_name) {",
)
rewrite(
    out / "mysql_scanner/src/storage/mysql_schema_entry.cpp",
    "bool CatalogTypeIsSupported(CatalogType type) {",
    "static bool CatalogTypeIsSupported(CatalogType type) {",
)

# mysql: use the system libmariadb (libmariadb-dev) instead of the vcpkg
# overlay port, and add the static archive upstream never creates (without
# it the extension cannot be statically linked at all).
rewrite(
    out / "mysql_scanner/CMakeLists.txt",
    """set(libmariadb_DIR ${CMAKE_CURRENT_LIST_DIR}/vcpkg_ports/libmariadb)
find_package(libmariadb REQUIRED)
set(EXTENSION_NAME ${TARGET_NAME}_extension)

set(MYSQL_INCLUDE_DIR
    ${CMAKE_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/include/mysql)
include_directories(${MYSQL_INCLUDE_DIR})
include_directories(database-connector/src/include)

add_subdirectory(src)

set(PARAMETERS "-no-warnings")
build_loadable_extension(${TARGET_NAME} ${PARAMETERS} ${ALL_OBJECT_FILES})

# Loadable binary
target_include_directories(${TARGET_NAME}_loadable_extension
                           PRIVATE include ${MYSQL_INCLUDE_DIR})
target_link_libraries(${TARGET_NAME}_loadable_extension ${MYSQL_LIBRARIES})
""",
    """# System libmariadb instead of the vcpkg overlay port (see pre-vendor).
find_path(MYSQL_INCLUDE_DIR mysql.h PATH_SUFFIXES mariadb mysql REQUIRED)
find_library(MYSQL_LIBRARY NAMES mariadb mariadbclient REQUIRED)
set(EXTENSION_NAME ${TARGET_NAME}_extension)

include_directories(${MYSQL_INCLUDE_DIR})
include_directories(database-connector/src/include)

add_subdirectory(src)

build_static_extension(${TARGET_NAME} ${ALL_OBJECT_FILES})
target_link_libraries(${TARGET_NAME}_extension ${MYSQL_LIBRARY})

set(PARAMETERS "-no-warnings")
build_loadable_extension(${TARGET_NAME} ${PARAMETERS} ${ALL_OBJECT_FILES})

# Loadable binary
target_include_directories(${TARGET_NAME}_loadable_extension
                           PRIVATE include ${MYSQL_INCLUDE_DIR})
target_link_libraries(${TARGET_NAME}_loadable_extension ${MYSQL_LIBRARY})
""",
)

# The sync script refuses to continue when an extension's vcpkg manifest
# declares dependencies and no vcpkg toolchain is configured. We satisfy
# them with Debian system packages instead (libssl-dev, libcurl4-openssl-dev,
# libpq-dev, libmariadb-dev in debian/control), so empty the manifests.
for name in ("httpfs", "postgres_scanner", "mysql_scanner"):
    manifest = out / name / "vcpkg.json"
    data = json.loads(manifest.read_text())
    assert data.get("dependencies"), f"{manifest}: expected vcpkg dependencies"
    data["dependencies"] = []
    manifest.write_text(json.dumps(data, indent=2) + "\n")
EOF
