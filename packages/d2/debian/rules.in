#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export PATH := {{GO_BINARY_PATH}}:$(PATH)
export CGO_ENABLED := 0
export GOCACHE := $(CURDIR)/debian/.cache/go-build
export GOFLAGS := -mod=vendor -trimpath -pgo=off
export GOTOOLCHAIN := local

%:
	dh $@

override_dh_auto_build:
	go build -ldflags='-s -w -X github.com/d2lang/d2/lib/version.Version=v$(DEB_VERSION_UPSTREAM)' -o d2 .
	mkdir -p debian/generated/man
	cp ci/release/template/man/d2.1 debian/generated/man/d2.1
	gzip -9n debian/generated/man/d2.1

override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 d2 debian/d2/usr/bin/d2

override_dh_auto_clean:
	rm -rf d2 debian/.cache debian/generated

override_dh_clean:
	dh_clean -Xvendor/
