#!/usr/bin/make -f

export PATH := {{RUST_INSTALL_PREFIX}}/bin:$(PATH)
export CARGO_HOME := $(CURDIR)/debian/.cargo-home
export CARGO_NET_OFFLINE := true
export CARGO_TARGET_DIR := $(CURDIR)/target

{{RUST_BUILD_TUNING}}

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --offline --package gleam --bin gleam

# Run gleam-core's unit tests only; the full workspace suite also needs
# Erlang/JS runtimes and network access. Skip the source hygiene test, which
# scans upstream sources and vendored build-tree artifacts.
override_dh_auto_test:
	cargo test --locked --offline --release --package gleam-core -- --skip tests::all_files_have_copyright_notice

override_dh_auto_clean:
	rm -rf target debian/.cargo-home

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_clean:
	dh_clean -Xvendor/
