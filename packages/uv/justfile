set no-cd

build suite="trixie" arch="all":
    ./scripts/build-targets.ts --build {{quote(suite)}} {{quote(arch)}}
    @just setup-rust {{quote(arch)}}
    ./packages/uv/build.ts {{quote(suite)}} {{quote(arch)}}

build-all arch="all":
    #!/usr/bin/env bash
    set -euo pipefail
    ./scripts/build-targets.ts --build-all {{quote(arch)}}
    for suite in $(./scripts/build-targets.ts --suites {{quote(arch)}}); do
      just uv::build "$suite" {{quote(arch)}}
    done
