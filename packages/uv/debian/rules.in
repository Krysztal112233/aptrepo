#!/usr/bin/make -f

export PATH := {{RUST_INSTALL_PREFIX}}/bin:$(PATH)
export CARGO_HOME := $(CURDIR)/debian/.cargo-home
export CARGO_NET_OFFLINE := true
export CARGO_TARGET_DIR := $(CURDIR)/target

{{RUST_BUILD_TUNING}}

%:
	dh $@

override_dh_update_autotools_config:

override_dh_autoreconf:

override_dh_auto_build:
	cargo build --release --locked --offline --package uv --bins
	mkdir -p debian/generated
	./target/release/uv generate-shell-completion bash > debian/generated/uv
	./target/release/uv generate-shell-completion fish > debian/generated/uv.fish
	./target/release/uv generate-shell-completion zsh > debian/generated/_uv
	./target/release/uvx --generate-shell-completion bash > debian/generated/uvx
	./target/release/uvx --generate-shell-completion fish > debian/generated/uvx.fish
	./target/release/uvx --generate-shell-completion zsh > debian/generated/_uvx

override_dh_auto_clean:
	rm -rf target debian/.cargo-home debian/generated

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_clean:
	dh_clean -Xvendor/
