#!/usr/bin/make -f

export PATH := {{RUST_INSTALL_PREFIX}}/bin:$(PATH)
export CARGO_HOME := $(CURDIR)/debian/.cargo-home
export CARGO_NET_OFFLINE := true
export CARGO_TARGET_DIR := $(CURDIR)/target

{{RUST_BUILD_TUNING}}

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --offline
	mkdir -p debian/generated
	./target/release/starship completions bash > debian/generated/starship.bash
	./target/release/starship completions fish > debian/generated/starship.fish
	./target/release/starship completions zsh > debian/generated/_starship

override_dh_auto_clean:
	rm -rf target debian/.cargo-home debian/generated

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_clean:
	dh_clean -Xvendor/
