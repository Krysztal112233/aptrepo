#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export PATH := {{GO_BINARY_PATH}}:$(PATH)
export CGO_ENABLED := 0
export GOCACHE := $(CURDIR)/debian/.cache/go-build
export GOFLAGS := -mod=vendor -trimpath

%:
	dh $@

override_dh_auto_build:
	go build -ldflags='-s -w -X main.version=$(DEB_VERSION_UPSTREAM) -X main.buildSource=debian' -o lazygit .
	mkdir -p debian/generated
	./lazygit completion bash > debian/generated/lazygit.bash
	./lazygit completion fish > debian/generated/lazygit.fish
	./lazygit completion zsh > debian/generated/_lazygit

override_dh_auto_test:
	mkdir .git; trap 'rmdir .git' EXIT; go test ./... -short

override_dh_auto_install:
	install -D -m 0755 lazygit debian/lazygit/usr/bin/lazygit

override_dh_auto_clean:
	rm -rf lazygit debian/.cache debian/generated
	rmdir .git 2>/dev/null || true

override_dh_clean:
	dh_clean -Xvendor/
