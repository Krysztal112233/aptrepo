#!/bin/sh
# Host-side source preparation ($1 = toolchain cargo, cwd = source tree).
# GitHub commit archives omit submodule contents. These gitlinks and hashes
# belong to source.commit e2a98e1b8af156988ad0ac778658ac27b60a55fb; review
# and refresh all four when advancing the snapshot.
# Keep the upstream Cargo.lock unchanged: the snapshot already includes the
# time and glium fixes that required dependency overrides in the 2024 release.
set -eu

TMP=""
trap 'rm -f "$TMP"' EXIT
fetch() { # <org/repo> <sha> <sha256> <dest>
    TMP=$(mktemp)
    curl -sfL --retry 3 "https://codeload.github.com/$1/tar.gz/$2" -o "$TMP"
    echo "$3  $TMP" | sha256sum -c - > /dev/null
    mkdir -p "$4"
    tar -xzf "$TMP" --strip-components=1 -C "$4"
    rm -f "$TMP"
}

fetch freetype/freetype2 42608f77f20749dd6ddc9e0536788eaad70ea4b5 \
    68ce87bb59ea209eb7350f41a94a27519ce16b37011b475a1e62d4abee154b66 \
    deps/freetype/freetype2
fetch glennrp/libpng f5e92d76973a7a53f517579bc95d61483bf108c0 \
    3689d30176661b821ce02c92baf801050bc3849d3428ff99c8afeb1ef4390c8c \
    deps/freetype/libpng
fetch madler/zlib 51b7f2abdade71cd9bb0e7a373ef2610ec6f9daf \
